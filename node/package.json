    "url": "git+https://github.com/violette-git/inline2css.git"
  },
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "inline2css": "bin/cli.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
